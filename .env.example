# ------------------------------------------------------------------
# MSSN AATU — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok.io
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000

# MySQL (matches docker-compose.yml)
DB_ENGINE=django.db.backends.mysql
DB_NAME=mssnaatu
DB_USER=mssnaatu
DB_PASSWORD=mssnaatu
DB_HOST=127.0.0.1
DB_PORT=3307

# Email — leave EMAIL_HOST empty to print emails in the console
DEFAULT_FROM_EMAIL="MSSN AATU <no-reply@mssnaatu.org>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Paystack — leave blank to use manual bank transfer
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Brevo transactional email — required for automatic news announcements
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MSSN AATU
PAYSTACK_CALLBACK_URL=http://localhost:8000/dues/callback/

# Annual dues bank transfer (enter verified MSSN AATU account details)
DUES_BANK_NAME=
DUES_ACCOUNT_NAME=
DUES_ACCOUNT_NUMBER=
